# Build output
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
backend/target/

# Playwright e2e output (frontend/e2e is committed; these are run artifacts)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# Generated: a copy of /content, rebuilt by `npm run sync-content` on every dev/build.
frontend/src/content-bundle/

# Local data
data/
*.db
*.db-journal
logs/
*.log

# Editors / OS
.idea/
.vscode/
.DS_Store

# Claude sync artifacts — a SendUserFile download lands here and must never be committed
Claude outputs/
*.tgz
.claude-sync.tgz
