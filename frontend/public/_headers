# Caching and security headers.
#
# This lives in public/ — and therefore inside dist/ — on purpose. netlify.toml sits at the
# repository root, where a *drag-and-drop* deploy never sees it: that deploy ships the contents
# of dist/ and nothing else. Keeping headers here means they apply however the site is
# published — dragged, CLI, or built from Git — and it keeps netlify.toml to the one thing that
# genuinely cannot live in dist/, which is how to run the build.
#
# Cloudflare Pages reads this file too, with the same syntax.

# Vite fingerprints everything in assets/, so the filename changes whenever the bytes do.
# Those are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached. A stale copy keeps asking for JS chunks from a build that
# no longer exists, and the site breaks for exactly the people who visited it before.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# A strict content security policy is nearly free here, because the site loads nothing from
# anywhere else: no fonts, no analytics, no CDN, no trackers, no third-party scripts. Everything
# it needs is in its own bundle, so the policy can say "self, and nothing else".
#
# Two exceptions, both real rather than lazy:
#   style-src 'unsafe-inline' — React writes inline styles for anything computed, such as the
#     animated width of a progress bar or a distribution chart. Removing it would mean hashing
#     every one of those on each build.
#   img-src / font-src data: — the inline SVG icons.
#
# `connect-src 'self'` is the line that matters most: it is what stops an injected script from
# sending anything anywhere. `form-action 'none'` matters because the app posts no forms at all,
# so any form submission would be something the app did not put there.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'none'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'
